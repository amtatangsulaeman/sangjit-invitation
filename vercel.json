{
  "cleanUrls": true,
  "headers": [
    { "source": "/assets/(.*)\\.(png|jpg|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/assets/(.*)\\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
